From 3dfe3ef397807d1b65a6e83ab783bab841e8d3e5 Mon Sep 17 00:00:00 2001
From: Macktherealonereally <macdev@mackthessd.org>
Date: Wed, 30 Sep 2026 09:13:50 +0200
Subject: [PATCH 1/3] aidl: lineage_health: Trim charging_enabled before
 parsing it

sec_battery prints the charging_enabled node as "%d\n", so the
comparison against "1"/"0" never matched and getChargingEnabled()
always returned EX_ILLEGAL_STATE. lineage-sdk's Toggle provider calls
getChargingEnabled() before every setChargingEnabled() (unless
config_chargingControlToggleSetAlways is set), so the exception made
it bail out and charging was never stopped at the configured limit.

Trim the value like FastCharge/WirelessFastCharge already do.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 aidl/lineage_health/ChargingControl.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/aidl/lineage_health/ChargingControl.cpp b/aidl/lineage_health/ChargingControl.cpp
index 8994cc3..7775246 100644
--- a/aidl/lineage_health/ChargingControl.cpp
+++ b/aidl/lineage_health/ChargingControl.cpp
@@ -7,6 +7,7 @@
 
 #include <android-base/file.h>
 #include <android-base/logging.h>
+#include <android-base/strings.h>
 
 #define LOG_TAG "vendor.lineage.health-service.samsung"
 
@@ -22,6 +23,9 @@ ndk::ScopedAStatus ChargingControl::getChargingEnabled(bool* _aidl_return) {
         return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
     }
 
+    // sec_battery prints the node with a trailing newline ("1\n").
+    content = android::base::Trim(content);
+
     if (content == "1") {
         *_aidl_return = true;
     } else if (content == "0") {
-- 
