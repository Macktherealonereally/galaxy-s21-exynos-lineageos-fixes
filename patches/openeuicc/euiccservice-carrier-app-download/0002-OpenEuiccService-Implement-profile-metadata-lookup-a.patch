 class OpenEuiccService : EuiccService(), OpenEuiccContextMarker {
     companion object {
         const val TAG = "OpenEuiccService"
+
+        // EuiccService.EXTRA_PACKAGE_NAME (@hide): calling package, set by the platform in the
+        // resolvedBundle passed to onDownloadSubscription()
+        private const val EXTRA_CALLING_PACKAGE_NAME = "android.service.euicc.extra.PACKAGE_NAME"
     }
 
     private val seId = EuiccChannel.SecureElementId.DEFAULT
@@ -151,14 +165,297 @@ class OpenEuiccService : EuiccService(), OpenEuiccContextMarker {
         // Not implemented
     }
 
+    /**
+     * Find a mapped port on physicalSlotId usable for a port-agnostic LPA operation (profile
+     * download, metadata lookup). If no port of the slot is currently mapped, one is mapped only
+     * when forceDeactivateSim is set (as that may deactivate another SIM).
+     *
+     * Returns null if the caller should return RESULT_MUST_DEACTIVATE_SIM; throws on failure.
+     */
+    private suspend fun EuiccChannelManagerContext.findOrMapPort(
+        physicalSlotId: Int,
+        portIndex: Int,
+        forceDeactivateSim: Boolean
+    ): Int? {
+        val port = euiccChannelManager.findFirstAvailablePort(physicalSlotId)
+        if (port >= 0) return port
+
+        if (!forceDeactivateSim) return null
+
+        val targetPort = if (portIndex >= 0) portIndex else 0
+        ensurePortIsMapped(physicalSlotId, targetPort)
+        return retryWithTimeout(5000) {
+            euiccChannelManager.withEuiccChannel(physicalSlotId, targetPort, seId) { channel ->
+                if (!channel.valid) {
+                    throw IllegalStateException("Slot $physicalSlotId port $targetPort is unavailable; may need to try again")
+                }
+                targetPort
+            }
+        } ?: throw IllegalStateException("Slot $physicalSlotId port $targetPort did not become available")
+    }
+
+    private fun DownloadableSubscription.parseActivationCode(): LPAString? =
+        getEncodedActivationCode()?.let { runCatching { LPAString.parse(it) }.getOrNull() }
+
+    private fun EuiccChannel.imeiOrNull(): String? =
+        try {
+            telephonyManager.getImei(logicalSlotId)
+        } catch (_: Exception) {
+            null
+        }
+
+    private fun RemoteProfileAccessRule.toUiccAccessRule(): UiccAccessRule? =
+        try {
+            UiccAccessRule(certificateHash.decodeHex(), packageName, 0)
+        } catch (e: Exception) {
+            Log.w(TAG, "Ignoring malformed access rule $this", e)
+            null
+        }
+
     override fun onGetDownloadableSubscriptionMetadata(
         slotId: Int,
         subscription: DownloadableSubscription?,
         forceDeactivateSim: Boolean
-    ): GetDownloadableSubscriptionMetadataResult {
-        // Stub: return as-is and do not fetch anything
-        // This is incompatible with carrier eSIM apps; should we make it compatible?
-        return GetDownloadableSubscriptionMetadataResult(RESULT_OK, subscription)
+    ): GetDownloadableSubscriptionMetadataResult =
+        if (subscription == null) {
+            GetDownloadableSubscriptionMetadataResult(RESULT_FIRST_USER, null)
+        } else {
+            // -1 = any port
+            onGetDownloadableSubscriptionMetadata(slotId, -1, subscription, forceDeactivateSim)
+        }
+
+    /**
+     * Fetch the profile metadata (name, provider, carrier privilege access rules) from the
+     * SM-DP+ without actually downloading the profile: run the download session up to
+     * ES9+.AuthenticateClient, which returns the metadata, then abort the session.
+     *
+     * The platform needs the access rules to allow an unprivileged carrier app to download
+     * the profile (EuiccController.checkCarrierPrivilegeInMetadata()).
+     */
+    override fun onGetDownloadableSubscriptionMetadata(
+        slotId: Int,
+        portIndex: Int,
+        subscription: DownloadableSubscription,
+        forceDeactivateSim: Boolean
+    ): GetDownloadableSubscriptionMetadataResult = withEuiccChannelManager {
+        Log.i(
+            TAG,
+            "onGetDownloadableSubscriptionMetadata slotId=$slotId portIndex=$portIndex forceDeactivateSim=$forceDeactivateSim"
+        )
+        if (shouldIgnoreSlot(slotId)) {
+            return@withEuiccChannelManager GetDownloadableSubscriptionMetadataResult(
+                RESULT_FIRST_USER,
+                null
+            )
+        }
+
+        val lpaString = subscription.parseActivationCode() ?: run {
+            Log.e(TAG, "Invalid or missing activation code")
+            return@withEuiccChannelManager GetDownloadableSubscriptionMetadataResult(
+                RESULT_FIRST_USER,
+                null
+            )
+        }
+
+        val port = try {
+            findOrMapPort(slotId, portIndex, forceDeactivateSim)
+                ?: return@withEuiccChannelManager GetDownloadableSubscriptionMetadataResult(
+                    RESULT_MUST_DEACTIVATE_SIM,
+                    null
+                )
+        } catch (e: Exception) {
+            Log.e(TAG, "No usable port on slot $slotId", e)
+            return@withEuiccChannelManager GetDownloadableSubscriptionMetadataResult(
+                RESULT_FIRST_USER,
+                null
+            )
+        }
+
+        euiccChannelManagerService.waitForForegroundTask()
+
+        var metadataReached = false
+        var metadata: RemoteProfileInfo? = null
+        try {
+            euiccChannelManager.withEuiccChannel(slotId, port, seId) { channel ->
+                channel.lpa.downloadProfile(
+                    ProfileDownloadInput(
+                        lpaString.address,
+                        lpaString.matchingId,
+                        channel.imeiOrNull(),
+                        subscription.confirmationCode
+                    )
+                ) { state ->
+                    if (state is ProfileDownloadState.ConfirmingDownload) {
+                        metadataReached = true
+                        metadata = state.metadata
+                        // We only want the metadata; abort (and cancel) the session here
+                        false
+                    } else {
+                        true
+                    }
+                }
+            }
+        } catch (e: LocalProfileAssistant.ProfileDownloadException) {
+            // Expected when we abort after receiving the metadata
+            if (!metadataReached) {
+                Log.e(TAG, "Failed to fetch profile metadata: ${e.lpaErrorReason}", e)
+                return@withEuiccChannelManager GetDownloadableSubscriptionMetadataResult(
+                    RESULT_FIRST_USER,
+                    null
+                )
+            }
+        } catch (e: Exception) {
+            Log.e(TAG, "Failed to fetch profile metadata", e)
+            return@withEuiccChannelManager GetDownloadableSubscriptionMetadataResult(
+                RESULT_FIRST_USER,
+                null
+            )
+        }
+
+        val builder = DownloadableSubscription.Builder(subscription)
+        val m = metadata
+        if (m != null) {
+            Log.i(
+                TAG,
+                "Profile metadata: provider=${m.providerName} name=${m.name} accessRules=${m.accessRules.size}"
+            )
+            if (m.providerName.isNotBlank()) {
+                builder.setCarrierName(m.providerName)
+            }
+            if (m.accessRules.isNotEmpty()) {
+                builder.setAccessRules(m.accessRules.mapNotNull { it.toUiccAccessRule() })
+            }
+        } else {
+            Log.w(TAG, "SM-DP+ did not return any profile metadata")
+        }
+
+        GetDownloadableSubscriptionMetadataResult(RESULT_OK, builder.build())
+    }
+
+    /**
+     * Download a profile on behalf of the platform (EuiccManager.downloadSubscription, used
+     * by carrier apps). The platform has already done all permission / consent checks by the
+     * time this is called.
+     */
+    override fun onDownloadSubscription(
+        slotIndex: Int,
+        portIndex: Int,
+        subscription: DownloadableSubscription,
+        switchAfterDownload: Boolean,
+        forceDeactivateSim: Boolean,
+        resolvedBundle: Bundle
+    ): DownloadSubscriptionResult {
+        Log.i(
+            TAG,
+            "onDownloadSubscription slotIndex=$slotIndex portIndex=$portIndex switchAfterDownload=$switchAfterDownload forceDeactivateSim=$forceDeactivateSim callingPackage=${
+                resolvedBundle.getString(EXTRA_CALLING_PACKAGE_NAME)
+            }"
+        )
+
+        fun result(code: Int, resolvableErrors: Int = 0, cardId: Int = TelephonyManager.UNSUPPORTED_CARD_ID) =
+            DownloadSubscriptionResult(code, resolvableErrors, cardId)
+
+        if (shouldIgnoreSlot(slotIndex)) return result(RESULT_FIRST_USER)
+
+        val lpaString = subscription.parseActivationCode() ?: run {
+            Log.e(TAG, "Invalid or missing activation code")
+            return result(RESULT_FIRST_USER)
+        }
+
+        if (lpaString.confirmationCodeRequired && subscription.confirmationCode.isNullOrEmpty()) {
+            // Ask the platform to get a confirmation code from the user (RESOLVE_RESOLVABLE_ERRORS)
+            return result(RESULT_RESOLVABLE_ERRORS, RESOLVABLE_ERROR_CONFIRMATION_CODE)
+        }
+
+        // Pair of (download result, (port, ICCID) of the new profile if known)
+        val (downloadResult, downloaded) =
+            withEuiccChannelManager<Pair<DownloadSubscriptionResult, Pair<Int, String>?>> {
+                val port = try {
+                    findOrMapPort(slotIndex, portIndex, forceDeactivateSim)
+                        ?: return@withEuiccChannelManager Pair(
+                            result(RESULT_MUST_DEACTIVATE_SIM),
+                            null
+                        )
+                } catch (e: Exception) {
+                    Log.e(TAG, "No usable port on slot $slotIndex", e)
+                    return@withEuiccChannelManager Pair(result(RESULT_FIRST_USER), null)
+                }
+
+                val (cardId, imei, iccidsBefore) =
+                    euiccChannelManager.withEuiccChannel(slotIndex, port, seId) { channel ->
+                        Triple(
+                            channel.cardId,
+                            channel.imeiOrNull(),
+                            channel.lpa.profiles.map { it.iccid }.toSet()
+                        )
+                    }
+
+                euiccChannelManagerService.waitForForegroundTask()
+                val handle = euiccChannelManagerService.launchProfileDownloadTask(
+                    slotIndex,
+                    port,
+                    seId,
+                    ProfileDownloadInput(
+                        lpaString.address,
+                        lpaString.matchingId,
+                        imei,
+                        subscription.confirmationCode
+                    )
+                )
+                // The consent for this download has already been given through the platform
+                // (carrier privileges or our resolution activity); confirm the metadata step.
+                handle.backChannel.send(true)
+
+                var metadataIccid: String? = null
+                val err = handle.stateFlow.onEach {
+                    val ctx = (it as? EuiccChannelManagerService.ForegroundTaskState.InProgress)?.context
+                    if (ctx is ProfileDownloadState.ConfirmingDownload) {
+                        metadataIccid = ctx.metadata?.iccid?.ifBlank { null }
+                    }
+                }.waitDone()
+
+                if (err != null) {
+                    Log.e(TAG, "Profile download failed", err)
+                    return@withEuiccChannelManager Pair(result(RESULT_FIRST_USER, cardId = cardId), null)
+                }
+
+                val newIccid = try {
+                    euiccChannelManager.withEuiccChannel(slotIndex, port, seId) { channel ->
+                        channel.lpa.profiles.map { it.iccid }.firstOrNull { it !in iccidsBefore }
+                    }
+                } catch (e: Exception) {
+                    null
+                } ?: metadataIccid
+
+                Log.i(TAG, "Downloaded profile iccid=$newIccid on slot $slotIndex port $port")
+                Pair(result(RESULT_OK, cardId = cardId), newIccid?.let { Pair(port, it) })
+            }
+
+        if (downloadResult.result != RESULT_OK || !switchAfterDownload) {
+            return downloadResult
+        }
+
+        val (port, iccid) = downloaded ?: run {
+            Log.e(TAG, "Downloaded profile not found; cannot switch to it")
+            return result(RESULT_FIRST_USER, cardId = downloadResult.cardId)
+        }
+
+        // Never report RESULT_MUST_DEACTIVATE_SIM at this point: the profile is already
+        // downloaded, and the platform would retry the whole download upon consent. Hence
+        // forceDeactivateSim = true: switchAfterDownload already implies replacing whatever
+        // profile is active on the target port.
+        val switchResult = onSwitchToSubscriptionWithPort(
+            slotIndex,
+            if (portIndex >= 0) portIndex else port,
+            iccid,
+            true
+        )
+        return if (switchResult == RESULT_OK) {
+            downloadResult
+        } else {
+            Log.e(TAG, "Profile downloaded but could not be enabled: $switchResult")
+            result(RESULT_FIRST_USER, cardId = downloadResult.cardId)
+        }
     }
 
     override fun onGetDefaultDownloadableSubscriptionList(
