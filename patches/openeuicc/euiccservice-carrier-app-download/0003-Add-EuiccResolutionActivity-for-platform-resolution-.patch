diff --git a/app/src/main/java/im/angry/openeuicc/ui/EuiccResolutionActivity.kt b/app/src/main/java/im/angry/openeuicc/ui/EuiccResolutionActivity.kt
new file mode 100644
index 0000000..c650485
--- /dev/null
+++ b/app/src/main/java/im/angry/openeuicc/ui/EuiccResolutionActivity.kt
@@ -0,0 +1,237 @@
+package im.angry.openeuicc.ui
+
+import android.content.DialogInterface
+import android.os.Bundle
+import android.service.euicc.EuiccService
+import android.telephony.SubscriptionManager
+import android.telephony.TelephonyManager
+import android.telephony.euicc.EuiccManager
+import android.util.Log
+import android.view.View
+import android.widget.EditText
+import androidx.appcompat.app.AlertDialog
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.widget.doAfterTextChanged
+import com.google.android.material.textfield.TextInputLayout
+import im.angry.openeuicc.R
+import im.angry.openeuicc.util.*
+
+/**
+ * LUI resolution activity: asks the user for consent (or input) when the platform
+ * (EuiccController) cannot complete an EuiccManager operation requested by an app on its own,
+ * then reports the user's decision back via EuiccManager.continueOperation().
+ *
+ * Started by com.android.phone's EuiccResolutionUiDispatcherActivity with one of
+ * - EuiccService.ACTION_RESOLVE_NO_PRIVILEGES: the calling app (e.g. a carrier app) has no
+ *   carrier privileges over the target eSIM; ask the user whether to allow the download / switch
+ * - EuiccService.ACTION_RESOLVE_DEACTIVATE_SIM: an active SIM must be turned off to continue
+ * - EuiccService.ACTION_RESOLVE_RESOLVABLE_ERRORS: a confirmation code and/or the user's consent
+ *   to profile policy rules is needed
+ *
+ * The intent's extras must be passed back untouched to continueOperation(), as they carry the
+ * pending operation. Declining (or dismissing) the dialog reports consent = false, which makes
+ * the platform fail the operation towards the calling app.
+ */
+class EuiccResolutionActivity : AppCompatActivity() {
+    companion object {
+        private const val TAG = "EuiccResolutionActivity"
+    }
+
+    private var resolved = false
+
+    private val resolutionCallingPackage: String? by lazy {
+        intent.getStringExtra(EuiccService.EXTRA_RESOLUTION_CALLING_PACKAGE)
+    }
+
+    private val callingAppLabel: CharSequence by lazy {
+        resolutionCallingPackage?.let { pkg ->
+            try {
+                packageManager.getApplicationLabel(packageManager.getApplicationInfo(pkg, 0))
+            } catch (e: Exception) {
+                Log.w(TAG, "Unable to load the label of $pkg", e)
+                pkg
+            }
+        } ?: getString(R.string.euicc_resolution_unknown_app)
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        window.setBackgroundDrawableResource(android.R.color.transparent)
+
+        Log.i(
+            TAG,
+            "Resolution requested: action=${intent.action} callingPackage=$resolutionCallingPackage " +
+                    "cardId=${intent.getIntExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID, -1)} " +
+                    "portIndex=${intent.getIntExtra(EuiccService.EXTRA_RESOLUTION_PORT_INDEX, -1)}"
+        )
+
+        val dialog = when (intent.action) {
+            EuiccService.ACTION_RESOLVE_NO_PRIVILEGES -> createNoPrivilegesDialog()
+            EuiccService.ACTION_RESOLVE_DEACTIVATE_SIM -> createDeactivateSimDialog()
+            EuiccService.ACTION_RESOLVE_RESOLVABLE_ERRORS -> createResolvableErrorsDialog()
+            else -> {
+                Log.w(TAG, "Unsupported resolution action ${intent.action}")
+                finish()
+                return
+            }
+        }
+
+        // Back cancels (= declines), but don't decline because of a stray tap outside the dialog
+        dialog.setCanceledOnTouchOutside(false)
+        dialog.setOnCancelListener { resolve(false) }
+        dialog.show()
+    }
+
+    override fun onDestroy() {
+        // Never leave the pending operation (and the calling app) hanging
+        if (isFinishing && !resolved) {
+            resolve(false)
+        }
+        super.onDestroy()
+    }
+
+    private fun dialogBuilder() =
+        AlertDialog.Builder(this, im.angry.openeuicc.common.R.style.AlertDialogTheme)
+            .setCancelable(true)
+
+    private fun createNoPrivilegesDialog(): AlertDialog {
+        // A valid subscription ID means that this is about switching to an existing profile;
+        // for downloads, the platform passes INVALID_SUBSCRIPTION_ID.
+        val isSwitch = intent.getIntExtra(
+            EuiccService.EXTRA_RESOLUTION_SUBSCRIPTION_ID,
+            SubscriptionManager.INVALID_SUBSCRIPTION_ID
+        ) != SubscriptionManager.INVALID_SUBSCRIPTION_ID
+
+        return dialogBuilder()
+            .setTitle(
+                getString(
+                    if (isSwitch) R.string.euicc_resolution_no_privileges_switch_title
+                    else R.string.euicc_resolution_no_privileges_title,
+                    callingAppLabel
+                )
+            )
+            .setMessage(
+                getString(
+                    if (isSwitch) R.string.euicc_resolution_no_privileges_switch_message
+                    else R.string.euicc_resolution_no_privileges_message,
+                    callingAppLabel
+                )
+            )
+            .setNegativeButton(R.string.euicc_resolution_deny) { _, _ -> resolve(false) }
+            .setPositiveButton(R.string.euicc_resolution_allow) { _, _ -> resolve(true) }
+            .create()
+    }
+
+    private fun createDeactivateSimDialog(): AlertDialog =
+        dialogBuilder()
+            .setTitle(R.string.euicc_resolution_deactivate_sim_title)
+            .setMessage(getString(R.string.euicc_resolution_deactivate_sim_message, callingAppLabel))
+            .setNegativeButton(R.string.euicc_resolution_cancel) { _, _ -> resolve(false) }
+            .setPositiveButton(R.string.euicc_resolution_continue) { _, _ -> resolve(true) }
+            .create()
+
+    private fun createResolvableErrorsDialog(): AlertDialog {
+        val errors = intent.getIntExtra(EuiccService.EXTRA_RESOLVABLE_ERRORS, 0)
+        val needsCode = errors and EuiccService.RESOLVABLE_ERROR_CONFIRMATION_CODE != 0
+        val needsPolicyRules = errors and EuiccService.RESOLVABLE_ERROR_POLICY_RULES != 0
+
+        val message = listOfNotNull(
+            if (needsCode) getString(
+                R.string.euicc_resolution_confirmation_code_message,
+                callingAppLabel
+            ) else null,
+            if (needsPolicyRules) getString(R.string.euicc_resolution_policy_rules_message) else null,
+        ).joinToString("\n\n")
+
+        val codeView: View? = if (needsCode) {
+            layoutInflater.inflate(R.layout.dialog_euicc_resolution_code, null).also { view ->
+                if (intent.getBooleanExtra(
+                        EuiccService.EXTRA_RESOLUTION_CONFIRMATION_CODE_RETRIED,
+                        false
+                    )
+                ) {
+                    view.requireViewById<TextInputLayout>(R.id.euicc_resolution_code_layout).error =
+                        getString(R.string.euicc_resolution_confirmation_code_retry)
+                }
+            }
+        } else {
+            null
+        }
+        val codeInput = codeView?.requireViewById<EditText>(R.id.euicc_resolution_code)
+
+        val dialog = dialogBuilder()
+            .setTitle(R.string.euicc_resolution_resolvable_errors_title)
+            .setMessage(message)
+            .setView(codeView)
+            .setNegativeButton(R.string.euicc_resolution_cancel) { _, _ -> resolve(false) }
+            .setPositiveButton(R.string.euicc_resolution_continue) { _, _ ->
+                resolve(true, Bundle().apply {
+                    if (needsCode) {
+                        putString(
+                            EuiccService.EXTRA_RESOLUTION_CONFIRMATION_CODE,
+                            codeInput?.text?.toString()?.trim()
+                        )
+                    }
+                    if (needsPolicyRules) {
+                        putBoolean(EuiccService.EXTRA_RESOLUTION_ALLOW_POLICY_RULES, true)
+                    }
+                })
+            }
+            .create()
+
+        if (codeInput != null) {
+            // Require a non-empty confirmation code; the platform fails the operation otherwise
+            dialog.setOnShowListener {
+                val positive = dialog.getButton(DialogInterface.BUTTON_POSITIVE)
+                positive.isEnabled = !codeInput.text.isNullOrBlank()
+                codeInput.doAfterTextChanged { positive.isEnabled = !it.isNullOrBlank() }
+            }
+        }
+
+        return dialog
+    }
+
+    /**
+     * Report the user's decision to the platform, which then continues (or fails) the pending
+     * operation, and finish.
+     */
+    private fun resolve(consent: Boolean, extras: Bundle = Bundle()) {
+        if (resolved) return
+        resolved = true
+
+        val resolutionExtras = Bundle(extras).apply {
+            putBoolean(EuiccService.EXTRA_RESOLUTION_CONSENT, consent)
+            // For RESOLVE_NO_PRIVILEGES the platform may ask us to pick the port to use
+            // (the intent carries an invalid port index in that case). Our eUICC ports are
+            // interchangeable for the purpose of the platform, so just use the default port.
+            if (intent.action == EuiccService.ACTION_RESOLVE_NO_PRIVILEGES &&
+                intent.getIntExtra(
+                    EuiccService.EXTRA_RESOLUTION_PORT_INDEX,
+                    TelephonyManager.DEFAULT_PORT_INDEX
+                ) < 0
+            ) {
+                putInt(EuiccService.EXTRA_RESOLUTION_PORT_INDEX, TelephonyManager.DEFAULT_PORT_INDEX)
+            }
+        }
+
+        Log.i(TAG, "Resolution ${intent.action} for $resolutionCallingPackage: consent=$consent")
+
+        try {
+            val cardId = intent.getIntExtra(
+                EuiccService.EXTRA_RESOLUTION_CARD_ID,
+                TelephonyManager.UNSUPPORTED_CARD_ID
+            )
+            val euiccManager = getSystemService(EuiccManager::class.java)!!.let {
+                if (cardId >= 0) it.createForCardId(cardId) else it
+            }
+            euiccManager.continueOperation(intent, resolutionExtras)
+        } catch (e: Exception) {
+            Log.e(TAG, "Unable to continue eUICC operation", e)
+        }
+
+        setResult(if (consent) RESULT_OK else RESULT_CANCELED)
+        if (!isFinishing) {
+            finish()
+        }
+    }
+}
