+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- eUICC resolution (user consent) dialogs, shown on behalf of apps using EuiccManager -->
+    <string name="euicc_resolution_unknown_app">Een app</string>
+    <string name="euicc_resolution_no_privileges_title">%1$s toestaan een eSIM te downloaden?</string>
+    <string name="euicc_resolution_no_privileges_message">%1$s wil een mobiel netwerkprofiel (eSIM) naar dit apparaat downloaden en inschakelen. Hierdoor kan het profiel dat nu op de eSIM in gebruik is, worden uitgeschakeld.\n\nSta dit alleen toe als je deze app vertrouwt.</string>
+    <string name="euicc_resolution_no_privileges_switch_title">%1$s toestaan je eSIM te wisselen?</string>
+    <string name="euicc_resolution_no_privileges_switch_message">%1$s wil een ander mobiel netwerkprofiel op je eSIM inschakelen. Het profiel dat nu op de eSIM in gebruik is, wordt uitgeschakeld.</string>
+    <string name="euicc_resolution_allow">Toestaan</string>
+    <string name="euicc_resolution_deny">Niet toestaan</string>
+    <string name="euicc_resolution_deactivate_sim_title">Huidig mobiel netwerk uitschakelen?</string>
+    <string name="euicc_resolution_deactivate_sim_message">Om door te gaan moet %1$s het mobiele netwerkprofiel uitschakelen dat nu op deze simkaart in gebruik is. Je kunt het later weer inschakelen.</string>
+    <string name="euicc_resolution_continue">Doorgaan</string>
+    <string name="euicc_resolution_cancel">Annuleren</string>
+    <string name="euicc_resolution_resolvable_errors_title">Aanvullende bevestiging nodig</string>
+    <string name="euicc_resolution_confirmation_code_message">Voer de bevestigingscode van je provider in om de eSIM te downloaden waar %1$s om vraagt.</string>
+    <string name="euicc_resolution_confirmation_code_retry">De bevestigingscode was onjuist. Probeer het opnieuw.</string>
+    <string name="euicc_resolution_confirmation_code_hint">Bevestigingscode</string>
+    <string name="euicc_resolution_policy_rules_message">Dit eSIM-profiel bevat beleidsregels van de provider, die bijvoorbeeld kunnen voorkomen dat het profiel wordt uitgeschakeld of verwijderd. Ga alleen door als je hiermee akkoord gaat.</string>
+</resources>
