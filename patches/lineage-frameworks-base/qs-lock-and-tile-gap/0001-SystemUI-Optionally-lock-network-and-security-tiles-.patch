+    /**
+     * Settings.Secure key: when 1, the tiles listed in
+     * {@code config_qsLockNetworkAndSecurityTiles} can't be used while the device is locked
+     * (secure lock screen) without unlocking first. 0 (default) keeps the AOSP behaviour.
+     */
+    private static final String QS_LOCK_NETWORK_AND_SECURITY = "qs_lock_network_and_security";
+
     private String mTileSpec;
     @Nullable
     @VisibleForTesting
@@ -545,6 +556,33 @@ public abstract class QSTileImpl<TState extends State> implements QSTile, Lifecy
         return mIsDestroyed.get();
     }
 
+    /**
+     * Whether "Lock network and security tiles" is on, this tile is one of them and the device
+     * is locked (secure keyguard, not unlocked by a trust agent). Called on the background thread.
+     */
+    private boolean requiresUnlockWhileLocked() {
+        final int userId = mHost.getUserId();
+        if (mTileSpec == null || Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                QS_LOCK_NETWORK_AND_SECURITY, 0, userId) == 0) {
+            return false;
+        }
+        if (!ArrayUtils.contains(mContext.getResources().getStringArray(
+                R.array.config_qsLockNetworkAndSecurityTiles), mTileSpec)) {
+            return false;
+        }
+        final KeyguardManager km = mContext.getSystemService(KeyguardManager.class);
+        return km != null && km.isDeviceLocked(userId);
+    }
+
+    /**
+     * Shows the bouncer and replays the click once the user has unlocked. arg2 = 1 skips the
+     * lock check for the replayed click; nothing happens if the bouncer is cancelled.
+     */
+    private void postClickAfterUnlock(int what, int eventId) {
+        mActivityStarter.postQSRunnableDismissingKeyguard(
+                () -> mHandler.obtainMessage(what, eventId, 1, null).sendToTarget());
+    }
+
     protected void checkIfRestrictionEnforcedByAdminOnly(State state, String userRestriction) {
         EnforcedAdmin admin = RestrictedLockUtilsInternal.checkIfRestrictionEnforced(mContext,
                 userRestriction, mHost.getUserId());
