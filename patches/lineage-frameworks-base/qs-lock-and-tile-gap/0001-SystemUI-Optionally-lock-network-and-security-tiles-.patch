     <!-- Whether to play turbulence noise after clicking the play button -->
     <bool name="config_turbulenceNoise">true</bool>
+
+    <!-- Quick Settings tiles (specs) that need an unlock first while the device is locked,
+         when Settings > Lock screen > "Lock network and security" is on
+         (Settings.Secure qs_lock_network_and_security, off by default).
+         Location (and VPN) already always require an unlock in AOSP. -->
+    <string-array name="config_qsLockNetworkAndSecurityTiles" translatable="false">
