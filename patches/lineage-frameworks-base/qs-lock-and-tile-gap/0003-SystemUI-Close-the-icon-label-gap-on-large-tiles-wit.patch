+/**
+ * Sizes the icon box of a large tile, which keeps the icon in the same place on every tile.
+ *
+ * Dual target tiles fill the whole [ToggleTargetSize] box with the icon background. Without a
+ * background, the empty end of the box would only push the label away from the bare icon, so it is
+ * left out of the measured width: the label then starts as far from the icon as it starts from the
+ * background on dual target tiles, and gets that room. The icon itself does not move and is not
+ * clipped, and RTL mirrors this as usual.
+ *
+ * @param progress how far the tile is resized from icon only (0f) to large (1f), for edit mode.
+ */
+fun Modifier.largeTileIconBox(
+    hasIconBackground: Boolean,
+    progress: () -> Float = { 1f },
+): Modifier {
+    return thenIf(!hasIconBackground) {
+            Modifier.layout { measurable, constraints ->
+                val placeable = measurable.measure(constraints)
+                val inset = (LargeTileIconInset.toPx() * progress()).roundToInt()
+                val width = (placeable.width - inset).coerceAtLeast(constraints.minWidth)
+                layout(width, placeable.height) { placeable.placeRelative(0, 0) }
+            }
+        }
+        .size(ToggleTargetSize)
+}
+
